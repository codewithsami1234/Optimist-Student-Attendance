# Copy this file to application.properties (same folder) and fill in real
# values before running the backend. application.properties itself should
# NEVER be committed to source control since it holds real credentials.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
server.port=8080

# ---------------------------------------------------------------------------
# MySQL datasource
# Run database/01_schema.sql then database/02_seed_data.sql against this
# database first (see database/README.md), or rely on DataSeeder to seed an
# empty database automatically on first boot.
# ---------------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/student_attendance?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=attendance_user
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# validate: schema.sql already applied manually (recommended for production).
# update:   let Hibernate create/alter tables itself (fine for local dev).
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# ---------------------------------------------------------------------------
# JWT
# Generate a real secret with: openssl rand -base64 48
# Must be at least 32 bytes; expiration is in milliseconds (86400000 = 24h).
# ---------------------------------------------------------------------------
app.jwt.secret=${JWT_SECRET:CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}

# Google Sign-In: comma-separated OAuth client IDs (Web client ID plus Android client ID).
app.google.client-ids=${GOOGLE_CLIENT_IDS:}

# Cloud Postgres: set DATABASE_URL=postgres://user:pass@host:5432/dbname (Render/Neon/Railway).
# The app maps that URL onto JDBC automatically.

app.seed.demo-user=${SEED_DEMO_USER:false}
app.seed.academic-data=${SEED_ACADEMIC:false}

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins. Do not use * with credentials.
# ---------------------------------------------------------------------------
app.cors.allowed-origins=${CORS_ORIGINS:http://localhost:8080}

app.auth.max-attempts=${AUTH_MAX_ATTEMPTS:8}
app.auth.window-ms=${AUTH_WINDOW_MS:900000}
app.attendance.low-threshold=${ATTENDANCE_THRESHOLD:75}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
logging.level.root=INFO
logging.level.com.studentattendance.backend=DEBUG
