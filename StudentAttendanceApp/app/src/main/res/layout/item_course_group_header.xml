<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_md"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/textCourseClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            tools:text="Computer Science · Semester 4 · A" />

        <TextView
            android:id="@+id/textCourseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            tools:text="Database Systems" />

        <TextView
            android:id="@+id/textCourseCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="Course Code: CS-401" />

        <TextView
            android:id="@+id/textCourseStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            tools:text="Students: 42 · Sessions: 58 · Average Attendance: 84.6%" />

        <TextView
            android:id="@+id/textCourseBelow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/error"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="Below 75%: 7" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
