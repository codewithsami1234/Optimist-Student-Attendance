<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <com.example.studentattendance.ui.splash.SplashAttendanceMarkView
            android:id="@+id/viewAttendanceMark"
            android:layout_width="@dimen/splash_mark_size"
            android:layout_height="@dimen/splash_mark_size"
            android:contentDescription="@string/splash_mark_description" />

        <LinearLayout
            android:id="@+id/rowIndicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dotPresent"
                android:layout_width="@dimen/spacing_sm"
                android:layout_height="@dimen/spacing_sm"
                android:background="@drawable/bg_splash_dot_present"
                android:contentDescription="@null" />

            <View
                android:id="@+id/dotOrganized"
                android:layout_width="@dimen/spacing_sm"
                android:layout_height="@dimen/spacing_sm"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_splash_dot_organized"
                android:contentDescription="@null" />

            <View
                android:id="@+id/dotReady"
                android:layout_width="@dimen/spacing_sm"
                android:layout_height="@dimen/spacing_sm"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_splash_dot_ready"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/textBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:letterSpacing="0.08"
            android:text="@string/splash_brand"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/splash_product"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_subtitle" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/splash_subtitle"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>
</FrameLayout>
