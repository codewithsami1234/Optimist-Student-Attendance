<?xml version="1.0" encoding="utf-8"?>
<!-- Release / physical-device policy: HTTPS only. Cleartext loopback is
     confined to the debug source set so a production APK cannot talk to
     10.0.2.2 or LAN HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
