<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.attendance.MarkAttendanceActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_background"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bar_background"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/title_mark_attendance"
            app:titleTextColor="@color/bar_content" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/textClassInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            tools:text="Computer Science · Semester 1 · Section A" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            tools:text="10 students · Fri, 21 Aug 2026" />

        <TextView
            android:id="@+id/textLiveSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/royal_green"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            tools:text="P: 0 · A: 0 · L: 0 · Lv: 0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tap_to_cycle_status"
            android:textColor="@color/sea_green"
            android:textSize="@dimen/text_size_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMarkAllPresent"
            style="@style/Widget.StudentAttendance.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/action_mark_all_present" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.StudentAttendance.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:hint="@string/search_students_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editAttendanceSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerStudents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_sm"
            tools:listitem="@layout/item_student_attendance" />

        <include layout="@layout/view_state_loading" android:id="@+id/includeLoading" />
        <include layout="@layout/view_state_empty" android:id="@+id/includeEmpty" />
        <include layout="@layout/view_state_error" android:id="@+id/includeError" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSaveAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:text="@string/action_save_attendance" />

</LinearLayout>
