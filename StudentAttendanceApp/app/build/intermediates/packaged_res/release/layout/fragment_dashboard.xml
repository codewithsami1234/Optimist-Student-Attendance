<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.dashboard.DashboardFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_greeting_hello"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/textUserName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold"
                            tools:text="Ayesha Khan" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="@dimen/avatar_size_md"
                        android:layout_height="@dimen/avatar_size_md"
                        android:background="@drawable/bg_avatar_circle">

                        <TextView
                            android:id="@+id/textAvatarInitials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/brand_primary"
                            android:textSize="@dimen/text_size_subtitle"
                            android:textStyle="bold"
                            tools:text="AK" />
                    </FrameLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/textFirstRun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:background="@drawable/bg_stat_card_blue"
                    android:padding="@dimen/spacing_md"
                    android:text="@string/dashboard_first_run"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/dashboard_todays_overview"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_md"
                    android:columnCount="2"
                    android:rowCount="2">

                    <include
                        android:id="@+id/cardTotalStudents"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/cardPresentToday"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/cardAbsentToday"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/cardAttendanceRate"
                        layout="@layout/view_stat_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1" />

                </GridLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:text="@string/dashboard_quick_actions"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_md"
                    android:columnCount="2"
                    android:rowCount="3">

                    <include
                        android:id="@+id/actionMarkAttendance"
                        layout="@layout/view_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/actionStudents"
                        layout="@layout/view_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/actionViewHistory"
                        layout="@layout/view_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/actionReports"
                        layout="@layout/view_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/actionDepartments"
                        layout="@layout/view_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="@dimen/spacing_sm" />

                    <include
                        android:id="@+id/actionImportExport"
                        layout="@layout/view_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1" />

                </GridLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:text="@string/dashboard_attendance_trend"
                    android:textColor="@color/royal_green"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/corner_radius_md"
                    app:cardElevation="@dimen/elevation_card"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleTrendRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:checkedButton="@id/buttonTrendWeekly"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonTrendWeekly"
                                style="@style/Widget.StudentAttendance.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/trend_weekly"
                                android:textAllCaps="false"
                                app:strokeColor="@color/divider" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonTrendMonthly"
                                style="@style/Widget.StudentAttendance.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/trend_monthly"
                                android:textAllCaps="false"
                                app:strokeColor="@color/divider" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.StudentAttendance.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/trend_scope_section">

                            <AutoCompleteTextView
                                android:id="@+id/dropdownTrendSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:popupBackground="@drawable/bg_popup_surface"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.StudentAttendance.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/trend_scope_student">

                            <AutoCompleteTextView
                                android:id="@+id/dropdownTrendStudent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:popupBackground="@drawable/bg_popup_surface"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.example.studentattendance.ui.dashboard.TrendChartView
                            android:id="@+id/chartWeeklyTrend"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="@dimen/spacing_sm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/layoutWeeklyTrend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_md"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:text="@string/dashboard_attendance_alerts"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutLowAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_md"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textNoAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/dashboard_no_alerts"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_md"
                    android:text="@string/dashboard_recent_activity"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_attendance_session" />

                <TextView
                    android:id="@+id/textNoRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_lg"
                    android:gravity="center"
                    android:text="@string/dashboard_no_recent_activity"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/view_state_loading" android:id="@+id/includeLoading" />

</FrameLayout>
